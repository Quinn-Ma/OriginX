{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Documentation derived from broker make_prompt and validate_request. This request schema file was not itself used at runtime. Cross-field constraints and image validation remain procedural.",
  "type": "array",
  "minItems": 1,
  "maxItems": 8,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "image_row",
      "request_id",
      "request_token",
      "original_instruction",
      "step",
      "horizon",
      "remaining_steps"
    ],
    "properties": {
      "image_row": {
        "type": "string",
        "pattern": "^CASE 0[1-8]$"
      },
      "request_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,180}--astra$"
      },
      "request_token": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$"
      },
      "original_instruction": {
        "type": "string"
      },
      "step": {
        "type": "integer",
        "minimum": 0
      },
      "horizon": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000
      },
      "remaining_steps": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000
      }
    }
  }
}
