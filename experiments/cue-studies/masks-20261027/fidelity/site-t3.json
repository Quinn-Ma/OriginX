{
  "site_name": "linux_egl",
  "placement": "linux_egl",
  "benchmark": "robocasa",
  "model": "xr1",
  "sequential_gpu": false,
  "model_residency": "resident",
  "native_device": "cuda:0",
  "python": {
    "sim": "/root/autodl-tmp/originx-harness-v2/work/autodl/sim-env/bin/python",
    "policy": "/root/originx-policy-env/bin/python",
    "planner": "/root/originx-planner-env/bin/python"
  },
  "pythonpath": {
    "sim": [
      "/root/autodl-tmp/originx-harness-v2/vendor/robocasa",
      "/root/autodl-tmp/originx-harness-v2/vendor/robosuite"
    ]
  },
  "env": {
    "MUJOCO_GL": "egl",
    "PYOPENGL_PLATFORM": "egl",
    "CUDA_VISIBLE_DEVICES": "0",
    "MUJOCO_EGL_DEVICE_ID": "0",
    "CUDA_DEVICE_ORDER": "PCI_BUS_ID",
    "PYTHONHASHSEED": "0",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONNOUSERSITE": "1",
    "OMP_NUM_THREADS": "4",
    "TOKENIZERS_PARALLELISM": "false",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_HOME": "/root/autodl-tmp/originx-harness-v2/work/autodl/hf-cache",
    "MPLBACKEND": "Agg",
    "MPLCONFIGDIR": "/root/autodl-tmp/originx-harness-v2/work/autodl/mpl-cache"
  },
  "renderer": {
    "kind": "native_nvidia_egl",
    "gl_vendor": "NVIDIA Corporation",
    "gl_renderer_prefix": "NVIDIA ",
    "gl_renderer": "NVIDIA H800 PCIe/PCIe/SSE2",
    "forbidden_env": [
      "MESA_D3D12_DEFAULT_ADAPTER_NAME"
    ]
  },
  "scope": "T3 engineering only; policy/planner paths are not yet admitted for task runs",
  "policy_rgb_samples": 0
}