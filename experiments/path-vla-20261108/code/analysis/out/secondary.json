 "instructions_per_task": {
  "DeliverStraw": [
   "Take a straw from the drawer in front and place it inside the glass cup on the dining counter."
  ],
  "GetToastedBread": [
   "Start the toaster. Once the lever pops up, take the bread to the plate on the dining counter."
  ],
  "PackIdenticalLunches": [
   "Place one avocado and one fish in each tupperware on the nearby counter, to pack two identical lunches.",
   "Place one avocado and one steak in each tupperware on the nearby counter, to pack two identical lunches.",
   "Place one bell pepper and one steak in each tupperware on the nearby counter, to pack two identical lunches."
  ],
  "SearingMeat": [
   "Grab the pan from the cabinet and place it on the front left burner on the stove. Then place the chicken drumstick on the stove and turn the burner on.",
   "Grab the pan from the cabinet and place it on the front left burner on the stove. Then place the fish on the stove and turn the burner on.",
   "Grab the pan from the cabinet and place it on the front left burner on the stove. Then place the shrimp on the stove and turn the burner on."
  ],
  "StirVegetables": [
   "Put the broccoli and cucumber in the pot. Retrieve the spatula and lightly stir the vegetables in the pot.",
   "Put the broccoli and potato in the pot. Retrieve the spatula and lightly stir the vegetables in the pot.",
   "Put the carrot and lemon in the pot. Retrieve the spatula and lightly stir the vegetables in the pot."
  ],
  "ArrangeTea": [
   "Pick the kettle from the counter and place it on the tray. Then pick the mug from the cabinet and place it on the tray. Then close the cabinet doors."
  ],
  "CuttingToolSelection": [
   "Place the appropriate cutting tool for cutting the avocado skin on the cutting board.",
   "Place the appropriate cutting tool for cutting the broccoli skin on the cutting board.",
   "Place the appropriate cutting tool for cutting the carrot skin on the cutting board."
  ],
  "RecycleBottlesByType": [
   "Move the plastic bottles in the middle to the plastics group, and the glass bottles in the middle to the glass group."
  ],
  "WaffleReheat": [
   "Open the microwave, place the bowl with waffle inside the microwave, then close the microwave door and turn it on."
  ],
  "WeighIngredients": [
   "Pick the bar and place it on the digital scale for weighing, and close the cabinet.",
   "Pick the boxed food and place it on the digital scale for weighing, and close the cabinet.",
   "Pick the canned food and place it on the digital scale for weighing, and close the cabinet."
  ]
 },
